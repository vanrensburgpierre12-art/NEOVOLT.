# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=neovolt_db
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:650

# PayPal Configuration
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# CourierGuy Configuration
COURIERGUY_API_KEY=your_courierguy_api_key
COURIERGUY_BASE_URL=https://api.thecourierguy.co.za

# Company Information for Shipping
COMPANY_ADDRESS=123 Business Street
COMPANY_CITY=Cape Town
COMPANY_POSTAL_CODE=8000
COMPANY_PHONE=+27123456789

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password