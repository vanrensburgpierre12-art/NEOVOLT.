# Production Environment Variables for Neovolt E-commerce
# Copy this file to .env and update with your actual production values

# Application
NODE_ENV=production
PORT=3001
FRONTEND_URL=https://yourdomain.com

# Database
DB_PASSWORD=your-super-secure-database-password-here

# Authentication
JWT_SECRET=your-super-secure-jwt-secret-key-here
ADMIN_PASSWORD=your-super-secure-admin-password-here

# Payment Gateways
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
STRIPE_SECRET_KEY=your-stripe-secret-key

# Yoco Payment Gateway (South Africa)
YOCO_API_URL=https://api.yoco.com/v1
YOCO_SECRET_KEY=your-yoco-secret-key
YOCO_PUBLIC_KEY=your-yoco-public-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Cloudinary (Image Storage)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-phone-number-id